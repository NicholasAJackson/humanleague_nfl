# Sleeper league id (the long number in your league URL on sleeper.app)
VITE_SLEEPER_LEAGUE_ID=1245387983213821952

# Local only: keep /login open so you can paste a Sleeper league ID for guest browse,
# even when SITE_PASSWORD / AUTH_SECRET are unset (dev auth bypass). Restart Vite after changing.
# VITE_DEV_LOGIN_SCREEN=1

# Optional: hide “All nominations” until this instant (ISO 8601). Unset uses code default: 2026-08-01T12:00:00Z.
# VITE_KEEPERS_REVEAL_AT=2026-08-01T12:00:00Z
# Optional: same instant for API filtering until reveal (defaults to 2026-08-01T12:00:00Z when unset)
# KEEPERS_REVEAL_AT=2026-08-01T12:00:00Z

# Optional: close rule suggestions / votes / discussion from this instant (ISO 8601). Unset: 2026-08-01T12:00:00Z.
# VITE_RULES_CHANGES_CLOSE_AT=2026-08-01T12:00:00Z
# RULES_CHANGES_CLOSE_AT=2026-08-01T12:00:00Z

# Optional: home page draft countdown target (ISO 8601). Unset: 2026-08-08T19:00:00+01:00 (7pm BST).
# VITE_DRAFT_AT=2026-08-08T19:00:00+01:00

# Postgres connection string (TCP). Local: postgresql://user:pass@localhost:5432/dbname
# (same DB you use in pgAdmin). On Vercel + Neon, use the connection string from the Neon dashboard.
DATABASE_URL=

# Optional: one shared password for the whole site. When set together with AUTH_SECRET (16+ chars),
# visitors must sign in; session is an HttpOnly cookie. Leave blank to keep the app open.
SITE_PASSWORD=admin
AUTH_SECRET=1234567890123456

# Optional: FantasyPros public API key (server-only). Enables /rankings live Half-PPR ECR view.
# Request at https://secure.fantasypros.com/api-keys/request/ — never use VITE_* for this.
# FANTASYPROS_API_KEY=
